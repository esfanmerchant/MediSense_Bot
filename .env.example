# =============================================================================
# MediSense — environment template
#
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#   cp .env.example .env
#
# Every variable below is validated at boot by api/app/core/config.py.
# The API refuses to start with a missing or malformed required value
# rather than failing later at the point of use.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Wall-clock zone of the clinic, as an IANA name. Appointment times are stored
# in UTC; a doctor's published "09:00-17:00" is interpreted in this zone, so
# getting it wrong shifts every appointment by the offset.
CLINIC_TIMEZONE=Asia/Karachi
# Must not exceed the storage buckets' own file_size_limit, or an upload the
# API accepts would be rejected by storage after the patient waited for it.
MAX_UPLOAD_BYTES=20971520
# Origin of the Next.js client, used for CORS and cookie scope.
CLIENT_ORIGIN=http://localhost:3000

# --- Database (Supabase Postgres) --------------------------------------------
# Supabase dashboard > Connect > ORMs > Prisma gives both of these verbatim.
#
# DATABASE_URL is the pooled connection (port 6543) used at runtime.
# DIRECT_URL is the direct connection (port 5432) — Prisma needs it for
# migrations, because the pooler cannot run DDL.
DATABASE_URL=
DIRECT_URL=

# --- Authentication ----------------------------------------------------------
# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be at least 32 characters. Use DIFFERENT values for each.
JWT_SECRET=
SESSION_SECRET=

# Inactivity timeout in seconds (R8). 120 = the required 2 minutes.
SESSION_IDLE_TIMEOUT_SECONDS=120
# Absolute session lifetime regardless of activity.
SESSION_ABSOLUTE_TIMEOUT_SECONDS=43200

# --- Supabase Storage (medical document storage) ------------------------------
# Project URL and keys: Supabase dashboard > Project Settings > API.
SUPABASE_URL=
# Publishable (anon) key — safe in the browser, subject to RLS.
SUPABASE_PUBLISHABLE_KEY=
# Service role key — SERVER ONLY. Bypasses RLS. Never expose to the client,
# never prefix it with NEXT_PUBLIC_, never commit it.
SUPABASE_SERVICE_ROLE_KEY=
# Buckets must be created as PRIVATE. Medical files are never publicly readable.
SUPABASE_DOCUMENTS_BUCKET=medical-documents
SUPABASE_AVATARS_BUCKET=avatars
# Signed-URL lifetime for private medical documents, in seconds. Short on
# purpose: the link is for the redirect that follows, not something to keep.
SUPABASE_SIGNED_URL_TTL_SECONDS=300
# How long to wait on a storage call before giving up.
STORAGE_TIMEOUT_SECONDS=30

# --- OCR (local fallback: PaddleOCR, in-process) ------------------------------
# Used when a patient has not granted AI consent, or the provider is
# unreachable. Keeps the document inside the deployment.
# Requires the optional extra:  pip install -e "api[ocr]"  (~500 MB)
OCR_ENABLED=true
OCR_DET_MODEL=PP-OCRv5_mobile_det
OCR_REC_MODEL=PP-OCRv5_mobile_rec
# PaddlePaddle 3.3.1 on Windows CPU crashes in the oneDNN executor with
# "ConvertPirAttribute2RuntimeAttribute not support". Plain kernels work.
OCR_ENABLE_MKLDNN=false
# Below this confidence a field is always sent for human review, whatever its
# type. OCR output is never treated as correct without confirmation (§24).
OCR_CONFIDENCE_REVIEW_THRESHOLD=0.90

# --- AI provider (vision OCR, chatbot, symptom analysis) ----------------------
# Google AI Studio API key. Server-side only — never expose to the client.
AI_API_KEY=
# Check https://ai.google.dev/gemini-api/docs/models before changing: retired
# models fail with a 404 that looks like a broken key.
AI_MODEL=gemini-3.6-flash
AI_TIMEOUT_SECONDS=60
# Vision extraction sends the document to an external provider, so it runs only
# for patients who granted AI consent. Off here means local OCR for everyone,
# whatever they consented to.
AI_VISION_OCR_ENABLED=true

# --- Billing -----------------------------------------------------------------
INVOICE_CURRENCY=PKR
# Tax on a consultation fee, as a percentage. Configuration rather than a
# literal: rates differ by jurisdiction and change, and a number compiled into
# the billing code is one nobody can correct without a deployment. Zero bills
# the fee and nothing else, which is the honest default for a deployment that
# has not been told its local rate.
INVOICE_TAX_PERCENT=0


# --- Email (SMTP) ------------------------------------------------------------
# For Gmail use a 16-character App Password (Google Account > Security >
# 2-Step Verification > App passwords), NEVER the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="MediSense <no-reply@medisense.local>"

# --- Shared state (optional) -------------------------------------------------
# Only needed when running more than one API worker. With it, the rate limiter
# counts one window across all of them and the live vitals feed reaches every
# connected browser rather than the share attached to one worker. Leave it
# empty for a single worker — that configuration is correct as it stands, and
# an unreachable Redis is treated as absent rather than as an outage.
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# --- Web Push ----------------------------------------------------------------
# The VAPID keypair that identifies this server to a browser's push service.
# Generate one:
#   python -c "from py_vapid import Vapid01; import base64; #     from cryptography.hazmat.primitives import serialization as s; #     v=Vapid01(); v.generate_keys(); b=lambda x: base64.urlsafe_b64encode(x).decode().rstrip('='); #     print('pub', b(v.public_key.public_bytes(s.Encoding.X962, s.PublicFormat.UncompressedPoint))); #     print('priv', b(v.private_key.private_numbers().private_value.to_bytes(32,'big')))"
#
# Leave both empty and push is simply off — the right default for a deployment
# that has not been given keys, rather than a crash on the first reminder.
# The private half signs the request and must never be prefixed NEXT_PUBLIC_.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Where a push service complains to before it starts dropping your messages.
VAPID_SUBJECT=mailto:you@example.com

# --- Browser build (NEXT_PUBLIC_*) -------------------------------------------
# Substituted into the JavaScript when the client is BUILT, not read when it
# runs. Anything here is public by definition, and a container image is bound
# to the values it was built with — staging and production need separate
# builds. See client/Dockerfile.
#
# Kept at the repository root so `docker compose build` can read them; the
# client also reads client/.env.local for local development.
#
# The browser's route to the API. Not the compose service name: the fetch
# happens on the user's machine, where this network does not exist.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Maps JavaScript API key, for the clinic map on a doctor's profile. Restrict
# it by HTTP referrer in the Google Cloud console — it ships in the bundle.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Feature flags -----------------------------------------------------------
# Outbound email. When false, nothing is queued at all — a queue that can never
# drain is worse than no queue, because enabling email later would then flood
# people with messages about things that happened weeks ago. In-app
# notifications are unaffected either way.
EMAIL_ENABLED=false
# Allow the /assistant and /ocr routes to call the external provider.
# Off is a degraded mode, not a broken one: the health assistant still runs its
# deterministic red-flag triage locally and still escalates an emergency — it
# just cannot answer the question. Document reading falls back to local OCR.
AI_ENABLED=true

# The public half of VAPID_PUBLIC_KEY above. Safe in the bundle by design: it
# is what the browser encrypts its push subscription to, and identifies the
# sender. The two must match, or every subscription is rejected on send.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
