// MediSense — Smart Healthcare Management System
// Normalized relational schema. See docs in README.md for the entity map.
//
// Design rules encoded here:
//   * Authorization is data, not code: DoctorPatientAssignment is the care
//     relationship a doctor's access to a patient is checked against.
//   * Machine-generated clinical text never lands in MedicalRecord directly.
//     It lands in ReportedSymptom / MedicalDocument and is promoted by a
//     doctor, so every clinical entry has a human author (R5, R6).
//   * Double booking and duplicate invoicing are prevented by database
//     constraints, not by application-level checks alone (R4).
//   * AuditLog has no update or delete path anywhere in the application (R6).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime traffic goes through Supabase's connection pooler (port 6543).
  url      = env("DATABASE_URL")
  // Migrations need a direct connection (port 5432) — the pooler cannot run DDL.
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// Enums
// ============================================================================

enum Role {
  ADMIN
  DOCTOR
  PATIENT
  NURSE // no dashboard yet; exists so break-glass (R3) has a real principal
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNDISCLOSED
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
  REFUNDED
  OVERDUE
}

enum DocumentType {
  PRESCRIPTION
  LAB_REPORT
  BLOOD_TEST
  MEDICAL_CERTIFICATE
  REFERRAL_LETTER
  DISCHARGE_SUMMARY
  IMAGING
  PROFILE_IMAGE
  OTHER
}

enum OcrStatus {
  PENDING
  PROCESSING
  EXTRACTED
  CONFIRMED
  FAILED
  SKIPPED
}

enum OcrEngine {
  TESSERACT
  GEMINI_VISION
  MANUAL
}

enum VitalType {
  HEART_RATE
  SYSTOLIC_BP
  DIASTOLIC_BP
  OXYGEN_SATURATION
  TEMPERATURE
  RESPIRATORY_RATE
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  ESCALATED
}

/// Provenance of a clinical statement. Only PHYSICIAN entries are the
/// authored medical record; everything else is staging until promoted (C7).
enum DataSource {
  PHYSICIAN
  PATIENT_REPORTED
  AI_ASSISTED
  OCR_EXTRACTED
  DEVICE
}

enum InputType {
  TEXT
  VOICE
}

enum NotificationType {
  APPOINTMENT_BOOKED
  APPOINTMENT_REMINDER
  APPOINTMENT_CANCELLED
  APPOINTMENT_RESCHEDULED
  MEDICATION_REMINDER
  INVOICE_ISSUED
  REPORT_UPLOADED
  VITAL_ALERT
  EMERGENCY_ACCESS
  ACCOUNT_SECURITY
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum EmergencyAccessStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum AuditAction {
  LOGIN
  LOGIN_FAILED
  LOGOUT
  SESSION_EXPIRED
  PASSWORD_RESET_REQUESTED
  PASSWORD_CHANGED
  USER_CREATED
  USER_UPDATED
  USER_STATUS_CHANGED
  PATIENT_RECORD_VIEW
  PATIENT_RECORD_CREATE
  PATIENT_RECORD_UPDATE
  PRESCRIPTION_CREATED
  PRESCRIPTION_UPDATED
  DOCUMENT_UPLOADED
  DOCUMENT_VIEWED
  DOCUMENT_DELETED
  APPOINTMENT_CREATED
  APPOINTMENT_UPDATED
  APPOINTMENT_CANCELLED
  CONSULTATION_COMPLETED
  INVOICE_CREATED
  INVOICE_UPDATED
  AI_INTERACTION
  OCR_PROCESSED
  OCR_CONFIRMED
  VITAL_RECORDED
  VITAL_ALERT
  EMERGENCY_ACCESS_GRANTED
  EMERGENCY_ACCESS_USED
  EMERGENCY_ACCESS_REVOKED
  ACCESS_DENIED
  CONFIG_CHANGED
}

enum AuditSeverity {
  INFO
  NOTICE
  WARNING
  BREAK_GLASS
  SECURITY
}

// ============================================================================
// Identity & sessions
// ============================================================================

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role
  phone        String?
  status       UserStatus @default(ACTIVE)

  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  failedLoginCount Int      @default(0)
  lockedUntil     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient Patient?
  doctor  Doctor?

  sessions         Session[]
  refreshTokens    RefreshToken[]
  passwordResets   PasswordResetToken[]
  notifications    Notification[]
  emergencyGrants  EmergencyAccess[]  @relation("EmergencyRequester")
  uploadedDocs     MedicalDocument[]  @relation("DocumentUploader")
  recordedVitals   Vital[]            @relation("VitalRecorder")
  acknowledgedAlerts Alert[]          @relation("AlertAcknowledger")

  @@index([role, status])
  @@map("users")
}

/// Server-side session. The 2-minute inactivity rule (R8) is enforced by
/// comparing `lastSeenAt` on every authenticated request — the client timer
/// is a courtesy, this is the enforcement.
model Session {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Device class drives the idle timeout tier (see C3 in the requirements triage).
  deviceClass String  @default("PERSONAL") // SHARED_TERMINAL | PERSONAL | MONITOR
  userAgent   String?
  ipAddress   String?

  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  revokedReason String?

  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

/// Rotating refresh tokens. Only the hash is stored; presenting an already
/// rotated token revokes the whole session (reuse detection).
model RefreshToken {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  replacedById String?

  @@index([sessionId])
  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// ============================================================================
// Organization
// ============================================================================

model Department {
  id          String  @id @default(cuid())
  name        String  @unique
  code        String  @unique
  description String?
  location    String?
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctors Doctor[]

  @@map("departments")
}

model Doctor {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  specialization String
  licenseNumber  String  @unique
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  qualifications  String?
  yearsExperience Int?
  consultationFee Decimal @default(0) @db.Decimal(10, 2)
  /// Weekly availability template: [{ dayOfWeek, startTime, endTime, slotMinutes }]
  availability    Json    @default("[]")
  acceptingPatients Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments     DoctorPatientAssignment[]
  appointments    Appointment[]
  medicalRecords  MedicalRecord[]
  prescriptions   Prescription[]
  timeOff         DoctorTimeOff[]
  alerts          Alert[]

  @@index([departmentId])
  @@index([specialization])
  @@map("doctors")
}

model DoctorTimeOff {
  id       String   @id @default(cuid())
  doctorId String
  doctor   Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  startsAt DateTime
  endsAt   DateTime
  reason   String?

  @@index([doctorId, startsAt])
  @@map("doctor_time_off")
}

model Patient {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  medicalRecordNumber String  @unique
  dateOfBirth         DateTime?
  gender              Gender  @default(UNDISCLOSED)
  bloodGroup          String?
  address             String?
  emergencyContactName  String?
  emergencyContactPhone String?
  allergies           String?
  chronicConditions   String?

  /// Consent for third-party AI / speech processing (C2). Checked before any
  /// payload leaves the system; withdrawal disables those features only.
  aiConsentGrantedAt  DateTime?
  aiConsentWithdrawnAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments      DoctorPatientAssignment[]
  appointments     Appointment[]
  medicalRecords   MedicalRecord[]
  prescriptions    Prescription[]
  documents        MedicalDocument[]
  vitals           Vital[]
  invoices         Invoice[]
  aiInteractions   AIInteraction[]
  reportedSymptoms ReportedSymptom[]
  alerts           Alert[]
  emergencyAccess  EmergencyAccess[]
  thresholds       VitalThreshold[]

  @@map("patients")
}

/// The care relationship. A doctor's access to a patient is authorized by a
/// row here (or by an active appointment) — never by the DOCTOR role alone.
model DoctorPatientAssignment {
  id        String  @id @default(cuid())
  doctorId  String
  doctor    Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  isPrimary Boolean   @default(false)
  assignedAt DateTime @default(now())
  endedAt    DateTime?
  assignedBy String?

  @@unique([doctorId, patientId])
  @@index([patientId, endedAt])
  @@map("doctor_patient_assignments")
}

// ============================================================================
// Appointments
// ============================================================================

model Appointment {
  id        String  @id @default(cuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId  String
  doctor    Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  appointmentDate DateTime
  startTime       DateTime
  endTime         DateTime
  status          AppointmentStatus @default(REQUESTED)
  reason          String?
  notes           String?

  /// Set to "<doctorId>|<ISO start>" while the appointment holds the slot and
  /// NULL once cancelled. The unique index below turns double-booking into a
  /// database error instead of a race (Postgres allows many NULLs).
  slotKey String?

  cancelledAt     DateTime?
  cancelledBy     String?
  cancelReason    String?
  rescheduledFromId String?
  completedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  medicalRecord MedicalRecord?
  invoice       Invoice?

  @@unique([slotKey])
  @@index([doctorId, startTime])
  @@index([patientId, startTime])
  @@index([status])
  @@map("appointments")
}

// ============================================================================
// Clinical records
// ============================================================================

model MedicalRecord {
  id            String  @id @default(cuid())
  patientId     String
  patient       Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String
  doctor        Doctor  @relation(fields: [doctorId], references: [id])
  appointmentId String? @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  symptoms      String?
  diagnosis     String?
  treatmentPlan String?
  notes         String?
  followUpDate  DateTime?
  followUpNotes String?

  /// Always PHYSICIAN for rows in this table. Machine output lives in
  /// ReportedSymptom / MedicalDocument until a doctor promotes it.
  source DataSource @default(PHYSICIAN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prescriptions    Prescription[]
  documents        MedicalDocument[]
  promotedSymptoms ReportedSymptom[]

  @@index([patientId, createdAt])
  @@index([doctorId])
  @@map("medical_records")
}

model Prescription {
  id              String  @id @default(cuid())
  patientId       String
  patient         Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId        String
  doctor          Doctor  @relation(fields: [doctorId], references: [id])
  medicalRecordId String?
  medicalRecord   MedicalRecord? @relation(fields: [medicalRecordId], references: [id], onDelete: SetNull)

  medication   String
  dosage       String
  frequency    String
  duration     String
  instructions String?
  startDate    DateTime?
  endDate      DateTime?
  active       Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId, active])
  @@index([medicalRecordId])
  @@map("prescriptions")
}

/// Staging tier for symptoms the patient reported (typed or via voice) and for
/// AI-extracted symptom lists. Never treated as a diagnosis; a doctor promotes
/// a row into a MedicalRecord, which is what gives it a clinical author.
model ReportedSymptom {
  id        String  @id @default(cuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  symptom    String
  severity   String?
  durationText String?
  rawText    String?
  source     DataSource @default(PATIENT_REPORTED)
  inputType  InputType  @default(TEXT)
  confidence Float?

  aiInteractionId String?
  aiInteraction   AIInteraction? @relation(fields: [aiInteractionId], references: [id], onDelete: SetNull)

  /// Set when a doctor accepts this into the authored record.
  promotedToRecordId String?
  promotedToRecord   MedicalRecord? @relation(fields: [promotedToRecordId], references: [id], onDelete: SetNull)
  promotedById       String?
  promotedAt         DateTime?

  createdAt DateTime @default(now())

  @@index([patientId, createdAt])
  @@map("reported_symptoms")
}

// ============================================================================
// Documents, storage & OCR
// ============================================================================

model MedicalDocument {
  id        String  @id @default(cuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User   @relation("DocumentUploader", fields: [uploadedById], references: [id])

  medicalRecordId String?
  medicalRecord   MedicalRecord? @relation(fields: [medicalRecordId], references: [id], onDelete: SetNull)

  documentType     DocumentType @default(OTHER)
  title            String?
  originalFileName String
  mimeType         String
  fileSize         Int
  checksumSha256   String?

  /// Files live in a PRIVATE Supabase Storage bucket and are addressed by path,
  /// never by a stored URL. A delivery URL is signed on demand only after the
  /// access check passes, so a document cannot be reached without going through
  /// RBAC and without producing an audit entry (conflict C8).
  storageBucket String @default("medical-documents")
  storagePath   String @unique

  ocrStatus     OcrStatus  @default(PENDING)
  ocrEngine     OcrEngine?
  ocrConfidence Float?
  extractedText String?
  /// Structured OCR output awaiting human confirmation, e.g.
  /// { medication, dosage, frequency, fields: [{ key, value, confidence }] }
  structuredData Json?
  confirmedById  String?
  confirmedAt    DateTime?
  ocrError       String?

  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId, createdAt])
  @@index([documentType])
  @@index([ocrStatus])
  @@map("medical_documents")
}

// ============================================================================
// Vitals & alerts
// ============================================================================

model Vital {
  id        String  @id @default(cuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  recordedById String?
  recordedBy   User?   @relation("VitalRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  source       DataSource @default(DEVICE)
  deviceId     String?

  heartRate       Int?
  systolicBp      Int?
  diastolicBp     Int?
  oxygenSaturation Float?
  temperature     Float?
  respiratoryRate Int?

  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  alerts Alert[]

  @@index([patientId, recordedAt])
  @@map("vitals")
}

/// Configurable thresholds (R17). A row with patientId = NULL is the hospital
/// default for that vital; a row with a patientId overrides it for one patient,
/// which is what stops alarm fatigue on chronic patients (C9).
model VitalThreshold {
  id        String     @id @default(cuid())
  vitalType VitalType
  patientId String?
  patient   Patient?   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  minValue Float?
  maxValue Float?
  severity AlertSeverity @default(WARNING)
  enabled  Boolean       @default(true)
  /// Number of consecutive breaching readings before an alert fires — filters
  /// sensor artefacts such as a detached probe.
  sustainedReadings Int @default(1)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([vitalType, patientId])
  @@map("vital_thresholds")
}

model Alert {
  id        String  @id @default(cuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  vitalId   String?
  vital     Vital?  @relation(fields: [vitalId], references: [id], onDelete: SetNull)
  doctorId  String?
  doctor    Doctor? @relation(fields: [doctorId], references: [id], onDelete: SetNull)

  vitalType    VitalType
  measuredValue Float
  thresholdMin Float?
  thresholdMax Float?
  severity     AlertSeverity
  status       AlertStatus   @default(OPEN)
  message      String

  acknowledgedById String?
  acknowledgedBy   User?    @relation("AlertAcknowledger", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  acknowledgedAt   DateTime?
  resolvedAt       DateTime?
  escalatedAt      DateTime?
  escalationLevel  Int      @default(0)

  createdAt DateTime @default(now())

  @@index([patientId, status])
  @@index([doctorId, status])
  @@index([status, createdAt])
  @@map("alerts")
}

// ============================================================================
// Billing
// ============================================================================

model Invoice {
  id        String  @id @default(cuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  /// Unique: one invoice per appointment. This is the idempotency guarantee
  /// for "complete consultation" retries (R4) — a duplicate insert fails at
  /// the database rather than being caught only by application logic.
  appointmentId String? @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  invoiceNumber String        @unique
  amount        Decimal       @db.Decimal(10, 2)
  taxAmount     Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount   Decimal       @db.Decimal(10, 2)
  currency      String        @default("INR")
  status        InvoiceStatus @default(DRAFT)
  /// Line items: [{ description, quantity, unitPrice, amount }]
  lineItems     Json          @default("[]")
  notes         String?

  issuedAt DateTime?
  dueAt    DateTime?
  paidAt   DateTime?
  voidedAt DateTime?
  /// Credit notes reference the invoice they correct; issued invoices are
  /// never edited in place (C4, R6).
  amendsInvoiceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId, status])
  @@map("invoices")
}

// ============================================================================
// AI & notifications
// ============================================================================

model AIInteraction {
  id        String  @id @default(cuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  sessionId        String
  input            String
  inputType        InputType @default(TEXT)
  /// Symptom terms the extractor pulled out, as a JSON string array.
  extractedSymptoms Json     @default("[]")
  response         String
  /// Set when the safety layer detects red-flag symptoms and escalates.
  emergencyFlagged Boolean   @default(false)
  recommendedDepartment String?
  urgencyLevel     String? // ROUTINE | SOON | URGENT | EMERGENCY
  modelName        String?
  latencyMs        Int?

  createdAt DateTime @default(now())

  reportedSymptoms ReportedSymptom[]

  @@index([patientId, createdAt])
  @@index([sessionId])
  @@map("ai_interactions")
}

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  channel NotificationChannel @default(IN_APP)
  status  NotificationStatus  @default(PENDING)
  title   String
  body    String
  /// Deep link into the SPA, e.g. /patient/appointments/<id>
  link     String?
  metadata Json?
  priority Int @default(0)

  sentAt   DateTime?
  readAt   DateTime?
  failedAt DateTime?
  error    String?

  createdAt DateTime @default(now())

  @@index([userId, status])
  @@index([userId, readAt])
  @@map("notifications")
}

// ============================================================================
// Emergency access & audit
// ============================================================================

/// Break-glass grant (R3, C1). Scoped to one patient, time-boxed, reviewed.
/// Never an unrestricted bypass: the grant carries its own expiry and every
/// read made under it writes an EMERGENCY_ACCESS_USED audit entry.
model EmergencyAccess {
  id          String  @id @default(cuid())
  requesterId String
  requester   User    @relation("EmergencyRequester", fields: [requesterId], references: [id])
  patientId   String
  patient     Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  reason      String
  status      EmergencyAccessStatus @default(ACTIVE)
  ipAddress   String?
  userAgent   String?

  grantedAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  revokedById String?

  /// Post-hoc compliance review — unreviewed grants surface on the admin dashboard.
  reviewedAt   DateTime?
  reviewedById String?
  reviewNotes  String?

  accessCount Int @default(0)

  @@index([patientId, status])
  @@index([requesterId])
  @@index([status, expiresAt])
  @@map("emergency_access")
}

/// Append-only (R6). The application exposes create and read only — there is
/// no update or delete path, and the deployment should additionally revoke
/// UPDATE/DELETE on this table for the application role.
///
/// `previousHash` / `entryHash` chain the entries so that a row silently
/// changed or removed at the database level breaks verification.
model AuditLog {
  id String @id @default(cuid())

  /// Deliberately NOT a foreign key.
  ///
  /// With `onDelete: SetNull` an admin deleting a user silently erased who did
  /// what across the entire history, and with `Restrict` no account could ever
  /// be removed. The audit trail has to outlive its subject, so the actor is
  /// stored as a plain reference. Erasure is handled by destroying the
  /// patient's data key (conflict C5), which leaves this record intact and
  /// still verifiable.
  userId String?

  actorRole  Role?
  action     AuditAction
  severity   AuditSeverity @default(INFO)
  entityType String?
  entityId   String?
  /// Patient whose data was touched, for per-patient access reports.
  patientId  String?

  ipAddress String?
  userAgent String?
  requestId String?
  /// References only — field names and record ids, never clinical values (C5).
  metadata  Json?

  emergencyAccessId String?

  previousHash String?
  entryHash    String

  timestamp DateTime @default(now())

  @@index([userId, timestamp])
  @@index([patientId, timestamp])
  @@index([action, timestamp])
  @@index([severity, timestamp])
  @@map("audit_logs")
}

// ============================================================================
// System configuration
// ============================================================================

model SystemConfig {
  key         String   @id
  value       Json
  description String?
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("system_config")
}
